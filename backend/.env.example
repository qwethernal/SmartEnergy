# Локально
DATABASE_URL="mysql://app:app@localhost:3306/energy_control"
JWT_SECRET="change-me-in-production-min-32-chars-long"
PORT=3000
CORS_ORIGIN="http://localhost:5173"
LOG_LEVEL=info
ELERING_NPS_BASE_URL=https://dashboard.elering.ee
ELERING_HTTP_TIMEOUT_MS=8000

# Опционально: если задан — GET /metrics только с заголовком Authorization: Bearer <токен>
# METRICS_BEARER_TOKEN=

# Coolify (переменные в UI Coolify, не коммитить реальные пароли):
# MYSQL_ROOT_PASSWORD=...
# MYSQL_PASSWORD=...
# MYSQL_DATABASE=energy_control
# MYSQL_USER=app
# DATABASE_URL=mysql://app:ТОТ_ЖЕ_ПАРОЛЬ@mysql:3306/energy_control
# JWT_SECRET=длинная-случайная-строка
# CORS_ORIGIN=https://твой-домен  (или http://IP:порт как открываешь сайт)
# WEB_HOST_PORT=80
# Опционально:
# LOG_LEVEL=info
